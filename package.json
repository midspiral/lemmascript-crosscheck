{
  "name": "lemmascript-crosscheck",
  "version": "0.1.0",
  "description": "Counterexample-driven runtime transfer checking for LemmaScript",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lemmascript-crosscheck": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "bignumber.js": "^11.1.5",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "lemmascript": ">=0.6.0 <0.7.0"
  },
  "peerDependenciesMeta": {
    "lemmascript": {
      "optional": true
    }
  }
}
